{"html": "<!DOCTYPE html>\n<html lang=\"fr\" data-theme=\"light\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>L'IA au quotidien — Le guide interactif</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Space+Mono:wght@400;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg:#FBFBFD; --surface:#FFFFFF; --ink:#1C1D24; --muted:#737984;\n    --primary:#5B54E6; --primary-soft:#F1F0FC; --accent:#DD8B26; --accent-soft:#FCF6EC;\n    --border:#EEEFF3; --code-bg:#16172022; --shadow:0 1px 2px rgba(20,21,28,.03),0 4px 16px rgba(20,21,28,.04);\n    --rail:#EAEBEF;\n  }\n  [data-theme=\"dark\"]{\n    --bg:#101118; --surface:#191B24; --ink:#ECEDF2; --muted:#969CA8;\n    --primary:#9089F6; --primary-soft:#21223A; --accent:#E6A752; --accent-soft:#2C2418;\n    --border:#282B36; --shadow:0 1px 2px rgba(0,0,0,.3),0 12px 32px rgba(0,0,0,.35);\n    --rail:#282B36;\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--bg);color:var(--ink);\n    font-family:'Newsreader',Georgia,serif;font-size:19px;line-height:1.78;\n    -webkit-font-smoothing:antialiased;transition:background .4s,color .4s;\n  }\n  /* ---- top bar ---- */\n  header{\n    position:fixed;top:0;left:0;right:0;height:58px;z-index:50;\n    display:flex;align-items:center;justify-content:space-between;\n    padding:0 22px;background:color-mix(in srgb,var(--surface) 86%,transparent);\n    backdrop-filter:blur(14px);border-bottom:1px solid var(--border);\n  }\n  .brand{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15px;letter-spacing:-.01em;display:flex;align-items:center;gap:9px}\n  .brand .dot{width:9px;height:9px;border-radius:50%;background:var(--primary);box-shadow:0 0 0 4px var(--primary-soft)}\n  .meter{display:flex;align-items:center;gap:12px}\n  .meter .label{font-family:'Space Grotesk',sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}\n  .meter .val{font-family:'Space Mono',monospace;font-size:15px;font-weight:700;color:var(--accent);min-width:74px;text-align:right}\n  .toggle{background:none;border:1px solid var(--border);color:var(--ink);width:34px;height:34px;border-radius:9px;cursor:pointer;font-size:15px;display:grid;place-items:center;transition:border-color .2s}\n  .toggle:hover{border-color:var(--primary)}\n  .progress{position:fixed;top:58px;left:0;height:2px;background:var(--accent);width:0;z-index:50;transition:width .1s linear}\n  /* ---- layout ---- */\n  .wrap{max-width:1140px;margin:0 auto;padding:0 22px;display:grid;grid-template-columns:230px 1fr;gap:54px}\n  nav.toc{position:sticky;top:96px;align-self:start;height:calc(100vh - 120px);overflow-y:auto;padding-top:8px;font-family:'Space Grotesk',sans-serif}\n  nav.toc .eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);margin-bottom:14px}\n  nav.toc a{display:block;font-size:13.5px;color:var(--muted);text-decoration:none;padding:6px 0 6px 14px;border-left:2px solid var(--rail);transition:color .2s,border-color .2s;line-height:1.35}\n  nav.toc a:hover{color:var(--ink)}\n  nav.toc a.active{color:var(--primary);border-color:var(--primary);font-weight:600}\n  main{min-width:0;padding-bottom:120px}\n  /* ---- hero ---- */\n  .hero{min-height:88vh;display:flex;flex-direction:column;justify-content:center;padding:90px 0 40px}\n  .hero .kicker{font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:600;letter-spacing:.04em;color:var(--primary);margin-bottom:22px;text-transform:uppercase}\n  .hero h1{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(40px,7vw,76px);line-height:.98;letter-spacing:-.03em;margin-bottom:24px}\n  .hero h1 em{font-style:normal;color:var(--accent)}\n  .hero .lede{font-size:clamp(20px,2.4vw,26px);color:var(--muted);max-width:560px;line-height:1.45}\n  .hero .scroll{margin-top:54px;font-family:'Space Grotesk',sans-serif;font-size:13px;color:var(--muted);display:flex;align-items:center;gap:10px}\n  .hero .scroll .arrow{display:inline-block;animation:bob 1.8s ease-in-out infinite}\n  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}\n  /* ---- sections ---- */\n  section{padding:64px 0;border-top:1px solid var(--border);opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}\n  section.visible{opacity:1;transform:none}\n  .num{font-family:'Space Mono',monospace;font-size:13px;color:var(--accent);font-weight:700;letter-spacing:.05em}\n  h2{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(27px,3.6vw,38px);line-height:1.1;letter-spacing:-.02em;margin:12px 0 26px}\n  h3{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:21px;margin:40px 0 14px;color:var(--ink)}\n  p{margin-bottom:20px;max-width:640px}\n  .lead{font-size:21px;color:var(--ink)}\n  strong{font-weight:600}\n  ul,ol{margin:0 0 18px 4px;max-width:640px}\n  li{margin:0 0 9px 22px;line-height:1.6}\n  /* ---- callout ---- */\n  .callout{background:var(--accent-soft);border-left:2px solid var(--accent);border-radius:0 10px 10px 0;padding:20px 24px;margin:32px 0;max-width:640px}\n  .callout .tag{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--accent);margin-bottom:7px}\n  .callout p{margin:0;font-size:17.5px}\n  /* ---- prompt card ---- */\n  .prompt{background:var(--surface);border:1px solid var(--border);border-radius:13px;margin:20px 0;max-width:640px;overflow:hidden;box-shadow:var(--shadow)}\n  .prompt .bar{display:flex;align-items:center;justify-content:space-between;padding:11px 16px;border-bottom:1px solid var(--border);background:var(--surface)}\n  .prompt .title{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:13.5px;color:var(--primary);display:flex;align-items:center;gap:8px}\n  .prompt .title::before{content:\"\";width:7px;height:7px;border-radius:50%;background:var(--primary)}\n  .copy{font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:600;border:1px solid var(--border);background:var(--surface);color:var(--muted);padding:5px 11px;border-radius:7px;cursor:pointer;transition:all .18s}\n  .copy:hover{color:var(--primary);border-color:var(--primary)}\n  .copy.done{color:#fff;background:var(--accent);border-color:var(--accent)}\n  .prompt pre{font-family:'Space Mono',monospace;font-size:13.5px;line-height:1.65;color:var(--ink);padding:16px 18px;white-space:pre-wrap;word-break:break-word}\n  /* compare */\n  .compare{display:grid;gap:14px;margin:18px 0;max-width:640px}\n  .compare .weak{opacity:.62}\n  /* clair grid */\n  .clair{display:grid;gap:10px;margin:18px 0;max-width:640px}\n  .clair .row{display:grid;grid-template-columns:42px 1fr;gap:14px;align-items:start;padding:14px 0;border-bottom:1px solid var(--border)}\n  .clair .letter{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:26px;color:var(--primary);line-height:1}\n  .clair .row b{font-family:'Space Grotesk',sans-serif;font-size:16px}\n  .clair .row span{display:block;color:var(--muted);font-size:16.5px;margin-top:2px}\n  /* routines / plan */\n  .plan{counter-reset:s;max-width:640px;margin:18px 0}\n  .plan .item{display:grid;grid-template-columns:38px 1fr;gap:14px;padding:15px 0;border-bottom:1px solid var(--border)}\n  .plan .item::before{counter-increment:s;content:counter(s);font-family:'Space Mono',monospace;font-weight:700;color:var(--accent);font-size:15px}\n  .plan .item b{font-family:'Space Grotesk',sans-serif;font-size:16.5px}\n  .plan .item p{margin:3px 0 0;font-size:16.5px;color:var(--muted)}\n  /* end */\n  .end{text-align:center;padding:70px 0 20px}\n  .end .big{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(26px,4vw,40px);color:var(--accent);letter-spacing:-.02em}\n  footer{border-top:1px solid var(--border);padding:30px 0;font-family:'Space Grotesk',sans-serif;font-size:13px;color:var(--muted);text-align:center}\n  /* mobile */\n  @media(max-width:880px){\n    body{font-size:18px}\n    .wrap{grid-template-columns:1fr;gap:0}\n    nav.toc{display:none}\n    .meter .label{display:none}\n    .hero{min-height:80vh}\n  }\n  @media(prefers-reduced-motion:reduce){\n    *{animation:none!important;transition:none!important}\n    section{opacity:1;transform:none}\n    html{scroll-behavior:auto}\n  }\n</style>\n</head>\n<body>\n<header>\n  <div class=\"brand\"><span class=\"dot\"></span>L'IA au quotidien</div>\n  <div class=\"meter\">\n    <span class=\"label\">Temps économisé</span>\n    <span class=\"val\" id=\"saved\">0 min</span>\n    <button class=\"toggle\" id=\"theme\" aria-label=\"Changer le thème\">◐</button>\n  </div>\n</header>\n<div class=\"progress\" id=\"bar\"></div>\n\n<div class=\"wrap\">\n  <nav class=\"toc\" id=\"toc\">\n    <div class=\"eyebrow\">Sommaire</div>\n  </nav>\n\n  <main>\n    <div class=\"hero\">\n      <div class=\"kicker\">Le guide pratique francophone</div>\n      <h1>Gagne <em>10 heures</em><br>par semaine avec l'IA.</h1>\n      <p class=\"lede\">Sans jargon, sans théorie inutile. Des méthodes concrètes que tu appliques dès aujourd'hui, sur les tâches que tu fais déjà.</p>\n      <div class=\"scroll\"><span class=\"arrow\">↓</span> Commence à lire — le compteur en haut grimpe avec toi</div>\n    </div>\n\n    <section id=\"s-intro\" data-min=\"40\">\n      <span class=\"num\">00 — Introduction</span>\n      <h2>Pourquoi ce guide va te faire gagner du temps</h2>\n      <p class=\"lead\">La plupart des gens testent un outil d'IA deux minutes, posent une question banale, puis retournent à leurs vieilles habitudes. Ce guide fait l'inverse : il transforme l'IA en assistant quotidien.</p>\n      <p>Il ne te promet pas de devenir expert. Il te promet de récupérer concrètement plusieurs heures chaque semaine, avec des outils que tu as déjà, sur des tâches que tu fais déjà.</p>\n      <div class=\"callout\"><div class=\"tag\">Comment lire ce guide</div><p>Lis l'intro et le chapitre 2 (la méthode du prompt) en entier — c'est la fondation. Ensuite, pioche les chapitres qui correspondent à <em>tes</em> tâches.</p></div>\n      <p>Une dernière chose : l'IA n'est pas magique, elle ne pense pas à ta place. Mais bien utilisée, c'est un assistant infatigable. À toi de garder le volant ; elle, elle fait le carburant.</p>\n    </section>\n\n    <section id=\"s-1\" data-min=\"55\">\n      <span class=\"num\">01 — Démarrage</span>\n      <h2>Choisir et configurer ses outils</h2>\n      <p>Inutile de t'éparpiller sur dix outils : pour 90 % de tes besoins quotidiens, un seul assistant conversationnel bien maîtrisé suffit largement.</p>\n      <h3>Les trois familles d'outils</h3>\n      <ul>\n        <li><strong>Les assistants conversationnels</strong> (ChatGPT, Claude, Gemini, Le Chat de Mistral) : ils écrivent, résument, traduisent, expliquent. Ton couteau suisse principal.</li>\n        <li><strong>Les générateurs d'images</strong> : utiles pour les visuels, mais secondaires si ton but est de gagner du temps sur le texte.</li>\n        <li><strong>Les outils spécialisés</strong> (transcription, lecture de PDF, automatisations) : on y vient au chapitre 8.</li>\n      </ul>\n      <h3>Lequel choisir ?</h3>\n      <p>Peu importe au début : les meilleurs se valent pour les usages courants. Prends-en un, reste dessus quelques semaines, apprends à bien lui parler. C'est la maîtrise qui fait la différence, pas l'outil.</p>\n      <div class=\"callout\"><div class=\"tag\">Astuce gratuite</div><p>Les versions gratuites suffisent pour démarrer. Ne paie un abonnement que le jour où tu sens une vraie limite te freiner — pas avant.</p></div>\n    </section>\n\n    <section id=\"s-2\" data-min=\"75\">\n      <span class=\"num\">02 — Le cœur du guide</span>\n      <h2>La méthode du prompt parfait</h2>\n      <p class=\"lead\">La qualité de ce que tu obtiens dépend à 90 % de la qualité de ta demande. La plupart des gens écrivent « écris-moi un mail » — forcément, le résultat est générique.</p>\n      <p>La solution tient en un cadre simple à retenir : <strong>C.L.A.I.R.</strong></p>\n      <div class=\"clair\">\n        <div class=\"row\"><span class=\"letter\">C</span><div><b>Contexte</b><span>Explique la situation : qui es-tu, dans quel but ?</span></div></div>\n        <div class=\"row\"><span class=\"letter\">L</span><div><b>Lecteur</b><span>Précise le destinataire et le ton attendu.</span></div></div>\n        <div class=\"row\"><span class=\"letter\">A</span><div><b>Action</b><span>Dis précisément quoi faire : rédiger, résumer, corriger…</span></div></div>\n        <div class=\"row\"><span class=\"letter\">I</span><div><b>Indications</b><span>Donne les contraintes : longueur, format, points à inclure.</span></div></div>\n        <div class=\"row\"><span class=\"letter\">R</span><div><b>Référence</b><span>Fournis un exemple. C'est le plus puissant des leviers.</span></div></div>\n      </div>\n      <div class=\"compare\">\n        <div class=\"prompt weak\"><div class=\"bar\"><span class=\"title\">✗ Demande faible</span><button class=\"copy\">Copier</button></div><pre>Écris un mail pour relancer un client.</pre></div>\n        <div class=\"prompt\"><div class=\"bar\"><span class=\"title\">✓ Version C.L.A.I.R.</span><button class=\"copy\">Copier</button></div><pre>Contexte : je suis artisan plombier, j'ai envoyé un devis il y a 10 jours, sans réponse.\nLecteur : un particulier, ton poli mais chaleureux, pas insistant.\nAction : rédige un mail de relance court.\nIndications : 6 lignes max, propose un appel cette semaine, finis par une question ouverte.\nRéférence : style proche de « Bonjour Madame Durand, j'espère que vous allez bien… »</pre></div>\n      </div>\n      <div class=\"callout\"><div class=\"tag\">Le réflexe à prendre</div><p>Tu n'obtiens jamais le résultat parfait du premier coup, et c'est normal. Réponds « plus court », « plus chaleureux », « ajoute tel point ». C'est une conversation, pas un distributeur.</p></div>\n    </section>\n\n    <section id=\"s-3\" data-min=\"65\">\n      <span class=\"num\">03 — Emails</span>\n      <h2>Reprendre le contrôle de tes emails</h2>\n      <p>L'email est le plus gros voleur de temps de la journée — et le terrain où l'IA te fait gagner le plus vite.</p>\n      <h3>Rédiger un email difficile en 30 secondes</h3>\n      <p>Refus, réclamation, mauvaise nouvelle : ceux qui te font procrastiner. Décris la situation en deux phrases, laisse l'IA poser une première version, ajuste le ton.</p>\n      <h3>Résumer un long fil</h3>\n      <p>Colle un échange à rallonge : « Résume ce fil en 5 points et liste les actions qui m'incombent. » 20 secondes au lieu de 5 minutes.</p>\n      <div class=\"prompt\"><div class=\"bar\"><span class=\"title\">Brouillon de réponse</span><button class=\"copy\">Copier</button></div><pre>Voici un email reçu : [colle l'email].\nRédige une réponse polie qui : accepte la réunion, propose mardi 14 h, et demande l'ordre du jour. Ton professionnel et concis.</pre></div>\n      <div class=\"callout\"><div class=\"tag\">Gain estimé</div><p>Pour 20 à 30 emails par jour, ces réflexes font gagner 3 à 4 heures par semaine. Presque la moitié de la promesse de ce guide.</p></div>\n    </section>\n\n    <section id=\"s-4\" data-min=\"55\">\n      <span class=\"num\">04 — Organisation</span>\n      <h2>Automatiser l'administratif</h2>\n      <p>Les tâches d'organisation sont répétitives et peu créatives : exactement ce que l'IA fait le mieux.</p>\n      <h3>Du chaos au plan d'action</h3>\n      <p>Tu sors d'une réunion avec dix idées en vrac ? Écris-les pêle-mêle puis : « Transforme ce désordre en liste de tâches claires, classées par priorité, avec une durée estimée. »</p>\n      <h3>Préparer une réunion</h3>\n      <ul>\n        <li>Génère un ordre du jour à partir d'un simple objectif.</li>\n        <li>Prépare des questions pour un prestataire ou un fournisseur.</li>\n        <li>Anticipe les objections d'un client et prépare tes réponses.</li>\n      </ul>\n      <div class=\"prompt\"><div class=\"bar\"><span class=\"title\">Compte-rendu express</span><button class=\"copy\">Copier</button></div><pre>À partir de ces notes de réunion : [colle tes notes],\nrédige un compte-rendu structuré avec : décisions prises, actions à mener (avec responsable), et points reportés.</pre></div>\n    </section>\n\n    <section id=\"s-5\" data-min=\"55\">\n      <span class=\"num\">05 — Contenu</span>\n      <h2>Créer du contenu sans page blanche</h2>\n      <p>Posts, articles, fiches produits, newsletters : le syndrome de la page blanche n'a plus lieu d'être.</p>\n      <h3>La technique des 10 angles</h3>\n      <p>Avant d'écrire : « Donne-moi 10 angles différents pour parler de [sujet]. » Tu choisis le meilleur, puis tu développes. Tu ne pars plus jamais de zéro.</p>\n      <h3>Un contenu, plusieurs formats</h3>\n      <div class=\"prompt\"><div class=\"bar\"><span class=\"title\">Décliner une idée</span><button class=\"copy\">Copier</button></div><pre>Voici l'idée de base : [ton idée].\nDécline-la en 3 formats : un post LinkedIn (ton pro), une légende Instagram (ton léger), un script de vidéo courte de 30 s (accroche + 3 points + appel à l'action).</pre></div>\n      <div class=\"callout\"><div class=\"tag\">Garde ta voix</div><p>Le piège : publier un texte « trop lisse ». Réinjecte toujours tes anecdotes et ton vocabulaire. L'IA fait 80 % du chemin ; les 20 % restants, c'est ce qui te rend unique.</p></div>\n    </section>\n\n    <section id=\"s-6\" data-min=\"50\">\n      <span class=\"num\">06 — Apprentissage</span>\n      <h2>Te former 3× plus vite</h2>\n      <p>L'IA est le meilleur professeur particulier jamais inventé : disponible 24h/24, patient, et capable d'adapter ses explications à ton niveau exact.</p>\n      <div class=\"prompt\"><div class=\"bar\"><span class=\"title\">Le prof qui s'adapte</span><button class=\"copy\">Copier</button></div><pre>Explique-moi [concept] comme si j'avais 12 ans, avec une analogie du quotidien.\nPuis pose-moi 3 questions pour vérifier que j'ai compris.</pre></div>\n      <h3>Digérer l'information</h3>\n      <ul>\n        <li>Colle un article long → résumé en 5 points clés.</li>\n        <li>Demande les termes techniques avec leur définition simple.</li>\n        <li>Fais-toi expliquer le « pour » et le « contre » pour te forger un avis.</li>\n      </ul>\n    </section>\n\n    <section id=\"s-7\" data-min=\"60\">\n      <span class=\"num\">07 — Mise en pratique</span>\n      <h2>7 routines prêtes à l'emploi</h2>\n      <p>Sept mini-routines à mettre en place dès cette semaine, chacune sur une tâche récurrente.</p>\n      <div class=\"plan\" id=\"routines\"></div>\n    </section>\n\n    <section id=\"s-8\" data-min=\"45\">\n      <span class=\"num\">08 — Niveau supérieur</span>\n      <h2>Faire travailler l'IA presque seule</h2>\n      <h3>Lire tes documents</h3>\n      <p>Les outils modernes acceptent PDF, images, tableaux. Analyse un contrat, extrais les données d'une facture, interroge un rapport de 40 pages sans le lire en entier.</p>\n      <h3>Créer tes propres assistants</h3>\n      <p>Configure un assistant sur mesure avec des instructions permanentes : ton style, ton métier, tes règles. Tu ne répètes plus le contexte à chaque fois.</p>\n      <h3>Enchaîner les automatisations</h3>\n      <p>Avec Make ou Zapier, connecte l'IA à tes autres applis : un email arrive → il est résumé ; un formulaire est rempli → une réponse est générée. Le niveau pilote automatique.</p>\n      <div class=\"callout\"><div class=\"tag\">Le bon ordre</div><p>N'attaque l'automatisation avancée qu'une fois les chapitres 2 à 5 maîtrisés. Automatiser un mauvais processus ne fait que produire des erreurs plus vite.</p></div>\n    </section>\n\n    <section id=\"s-fin\" data-min=\"40\">\n      <span class=\"num\">09 — Action</span>\n      <h2>Par où commencer maintenant</h2>\n      <p class=\"lead\">Lire ne suffit pas : le seul chapitre qui compte, c'est celui que tu appliques. Voici ton plan pour 7 jours.</p>\n      <div class=\"plan\">\n        <div class=\"item\"><div><b>Aujourd'hui</b><p>Choisis un seul outil et relis le chapitre 2 (le cadre C.L.A.I.R.).</p></div></div>\n        <div class=\"item\"><div><b>Demain</b><p>Applique-le à ta tâche la plus pénible (souvent un email ou un document).</p></div></div>\n        <div class=\"item\"><div><b>Cette semaine</b><p>Mets en place 2 des 7 routines du chapitre 7.</p></div></div>\n        <div class=\"item\"><div><b>Dans 7 jours</b><p>Compte le temps gagné. Tu seras surpris.</p></div></div>\n      </div>\n      <div class=\"end\">\n        <div class=\"big\">Garde le volant.<br>Laisse l'IA faire le carburant.</div>\n      </div>\n    </section>\n\n    <section id=\"s-bonus\" data-min=\"60\">\n      <span class=\"num\">Bonus</span>\n      <h2>12 prompts à copier-coller</h2>\n      <p>Remplace simplement le texte entre crochets par ta propre situation. Clique pour copier.</p>\n      <div id=\"prompts\"></div>\n    </section>\n\n    <footer>L'IA au quotidien — guide interactif · <span id=\"year\"></span> · [ Ton nom / ta marque ]</footer>\n  </main>\n</div>\n\n<script>\n// ---------- data ----------\nconst sections=[\n  [\"s-intro\",\"Introduction\"],[\"s-1\",\"1 · Démarrage\"],[\"s-2\",\"2 · Le prompt parfait\"],\n  [\"s-3\",\"3 · Emails\"],[\"s-4\",\"4 · Organisation\"],[\"s-5\",\"5 · Contenu\"],\n  [\"s-6\",\"6 · Apprentissage\"],[\"s-7\",\"7 · Routines\"],[\"s-8\",\"8 · Niveau supérieur\"],\n  [\"s-fin\",\"9 · Passer à l'action\"],[\"s-bonus\",\"Bonus · 12 prompts\"]\n];\nconst routines=[\n  [\"Le tri du matin\",\"Colle ta liste de tâches en vrac → classement par priorité et urgence. Tu démarres avec un plan clair en 30 secondes.\"],\n  [\"La relance automatique\",\"Garde un prompt de relance prêt. Dès qu'un devis ou une facture traîne, tu génères le message en un instant.\"],\n  [\"Le résumé de réunion\",\"À chaque fin de réunion, transforme tes notes en compte-rendu structuré avant d'avoir quitté la salle.\"],\n  [\"L'idée de contenu\",\"Chaque lundi, demande 10 idées de publications pour la semaine. Plus jamais à court d'inspiration.\"],\n  [\"Le traducteur de confiance\",\"Pour tout message à l'international, fais traduire ET adapter au ton local, pas juste mot à mot.\"],\n  [\"Le correcteur final\",\"Avant d'envoyer un document important : relecture orthographe + clarté + ton. Un filet de sécurité gratuit.\"],\n  [\"Le brainstorm express\",\"Bloqué sur une décision ? Demande avantages, inconvénients et une reco argumentée. Tu débloques en 2 minutes.\"]\n];\nconst prompts=[\n  [\"Relancer sans insister\",\"Rédige un mail de relance court et chaleureux pour [situation]. 6 lignes max, propose une prochaine étape concrète.\"],\n  [\"Résumer un texte\",\"Résume ce texte en 5 points clés et liste les actions à retenir : [colle le texte].\"],\n  [\"Décliner une idée\",\"Transforme cette idée en post LinkedIn, légende Instagram et script vidéo de 30 s : [ton idée].\"],\n  [\"Préparer une réunion\",\"Crée un ordre du jour et 5 questions clés pour une réunion sur [sujet], durée 30 min.\"],\n  [\"Expliquer simplement\",\"Explique [concept] avec une analogie simple, puis vérifie ma compréhension avec 3 questions.\"],\n  [\"Corriger un document\",\"Relis ce texte : corrige l'orthographe, améliore la clarté, garde mon ton : [colle le texte].\"],\n  [\"Trancher une décision\",\"Donne les avantages, inconvénients et ta recommandation argumentée pour : [ta décision].\"],\n  [\"Trouver des angles\",\"Donne-moi 10 angles originaux pour parler de [sujet] sur les réseaux sociaux.\"],\n  [\"Traduire et adapter\",\"Traduis ce message en [langue] en adaptant le ton au contexte local : [texte].\"],\n  [\"Compte-rendu express\",\"Transforme ces notes en compte-rendu structuré (décisions, actions, responsables) : [notes].\"],\n  [\"Plan de tâches\",\"Classe ces tâches par priorité et urgence, avec une durée estimée : [liste].\"],\n  [\"Brouillon de réponse\",\"Rédige une réponse polie et concise à cet email : [colle l'email]. Objectif : [ton intention].\"]\n];\n\n// ---------- build TOC ----------\nconst toc=document.getElementById('toc');\nsections.forEach(([id,label])=>{\n  const a=document.createElement('a');a.href='#'+id;a.textContent=label;a.dataset.id=id;toc.appendChild(a);\n});\n\n// ---------- build routines ----------\nconst rc=document.getElementById('routines');\nroutines.forEach(r=>{\n  const d=document.createElement('div');d.className='item';\n  d.innerHTML='<div><b>'+r[0]+'</b><p>'+r[1]+'</p></div>';rc.appendChild(d);\n});\n\n// ---------- build prompts ----------\nconst pc=document.getElementById('prompts');\nprompts.forEach(p=>{\n  const card=document.createElement('div');card.className='prompt';\n  card.innerHTML='<div class=\"bar\"><span class=\"title\">'+p[0]+'</span><button class=\"copy\">Copier</button></div><pre>'+p[1]+'</pre>';\n  pc.appendChild(card);\n});\n\n// ---------- copy buttons ----------\ndocument.addEventListener('click',e=>{\n  if(!e.target.classList.contains('copy'))return;\n  const txt=e.target.closest('.prompt').querySelector('pre').innerText;\n  const done=()=>{e.target.textContent='Copié ✓';e.target.classList.add('done');setTimeout(()=>{e.target.textContent='Copier';e.target.classList.remove('done');},1500);};\n  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(txt).then(done).catch(done);}\n  else{const t=document.createElement('textarea');t.value=txt;document.body.appendChild(t);t.select();try{document.execCommand('copy');}catch(_){}t.remove();done();}\n});\n\n// ---------- scroll reveal ----------\nconst obs=new IntersectionObserver(es=>{es.forEach(en=>{if(en.isIntersecting)en.target.classList.add('visible');});},{threshold:.12});\ndocument.querySelectorAll('section').forEach(s=>obs.observe(s));\n\n// ---------- progress + time saved + active toc ----------\nconst bar=document.getElementById('bar'),saved=document.getElementById('saved');\nconst TOTAL=600; // 10h en minutes\nconst links=[...document.querySelectorAll('nav.toc a')];\nconst fmt=m=>{m=Math.round(m);if(m<60)return m+' min';const h=Math.floor(m/60),r=m%60;return h+' h'+(r?' '+r:'')+(r?'':'');};\nfunction onScroll(){\n  const st=window.scrollY,doch=document.documentElement.scrollHeight-window.innerHeight;\n  const pct=doch>0?Math.min(st/doch,1):0;\n  bar.style.width=(pct*100)+'%';\n  saved.textContent=fmt(pct*TOTAL);\n  // active section\n  let cur=sections[0][0];\n  for(const [id] of sections){const el=document.getElementById(id);if(el&&el.getBoundingClientRect().top<140)cur=id;}\n  links.forEach(a=>a.classList.toggle('active',a.dataset.id===cur));\n}\nwindow.addEventListener('scroll',onScroll,{passive:true});window.addEventListener('resize',onScroll);onScroll();\n\n// ---------- theme toggle ----------\nconst root=document.documentElement,tb=document.getElementById('theme');\ntb.addEventListener('click',()=>{root.dataset.theme=root.dataset.theme==='dark'?'light':'dark';});\n\ndocument.getElementById('year').textContent=new Date().getFullYear();\n</script>\n</body>\n</html>\n"}