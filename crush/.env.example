# Supabase — projet dédié à l'app Crush
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # serveur uniquement, jamais exposée au client

# Anti-spam : sel utilisé pour hacher les IP avant stockage (chaîne aléatoire au choix)
RATE_LIMIT_SALT=

# Publication Instagram automatique (étape 2, optionnel au démarrage)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# URL publique du site (utilisée pour générer l'image du post depuis les routes serveur)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
