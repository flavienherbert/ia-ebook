# Public URL of the deployed site (used for canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://klarim.fr

# Optional: webhook URL that receives contact form submissions as JSON
# (e.g. a Zapier/Make webhook, a Slack incoming webhook, or your own CRM endpoint).
# If unset, submissions are only logged server-side — useful for local development.
CONTACT_WEBHOOK_URL=
